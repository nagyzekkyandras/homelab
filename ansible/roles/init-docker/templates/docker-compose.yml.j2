version: '3.8'

networks:
  gitea-net:
    driver: bridge

services:
  server:
    image: gitea/gitea:1.21.11
    container_name: gitea-server
    environment:
      - USER_UID=1000
      - USER_GID=1000
      - GITEA__repository__ENABLE_ACT_RUNNER=true
    restart: always
    networks:
      - gitea-net
    volumes:
      - ./gitea-data:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "3000:3000"
      - "2222:22"

  runner:
    image: gitea/act_runner:latest
    container_name: gitea-runner
    restart: always
    networks:
      - gitea-net
    volumes:
      - ./runner-data:/data
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - GITEA_INSTANCE_URL=http://server:3000
      - GITEA_RUNNER_REGISTRATION_TOKEN={{ gitea_runner_token | default('IDE_JON_A_TOKEN') }}
      - GITEA_RUNNER_NAME={{ gitea_runner_name | default('gitea-runner-01') }}
      - GITEA_RUNNER_LABELS=ubuntu-latest:docker://node:16-bullseye,ubuntu-22.04:docker://node:16-bullseye
    depends_on:
      - server